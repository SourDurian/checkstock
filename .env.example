SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASSWORD=your-smtp-password-or-authorization-code
MAIL_FROM=VMISS Stock Monitor <sender@example.com>
ALERT_TO=recipient@example.com

# Gmail compatibility mode. Use these two instead of SMTP_* if preferred.
# GMAIL_USER=your-address@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password
